<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Undangan Pernikahan - Wang Li & Dinda</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome 6 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            sage: {
              50: '#f4f7f4',
              100: '#e3ebe3',
              200: '#c7d7c7',
              600: '#527853',
              700: '#3e5c3e',
              800: '#2b3f2b',
            },
            dustyrose: {
              100: '#f8ecee',
              300: '#e2b3be',
              500: '#c58b98',
            },
            gold: {
              400: '#d4af37',
              500: '#c59b27',
            },
            cream: '#fcfbf7'
          },
          fontFamily: {
            serif: ['Cormorant Garamond', 'serif'],
            cursive: ['Great Vibes', 'cursive'],
            sans: ['Montserrat', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #fcfbf7;
      color: #2b3f2b;
      font-family: 'Montserrat', sans-serif;
    }
    .bg-botanical {
      background-image: radial-gradient(rgba(82, 120, 83, 0.08) 1px, transparent 0);
      background-size: 24px 24px;
    }
    .watercolor-overlay {
      background: radial-gradient(circle, rgba(227,235,227,0.5) 0%, rgba(252,251,247,0.95) 70%);
    }
    @keyframes floatLeaf {
      0% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(5deg); }
      100% { transform: translateY(0px) rotate(0deg); }
    }
    .animate-float {
      animation: floatLeaf 4s ease-in-out infinite;
    }
  </style>
</head>
<body class="relative bg-botanical overflow-x-hidden">

  <!-- AUDIO PLAYER (HIDDEN) -->
  <audio id="weddingMusic" loop preload="auto">
    <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-wedding-114227.mp3" type="audio/mpeg">
  </audio>

  <!-- FLOATING AUDIO CONTROL BUTTON -->
  <button id="musicToggle" onclick="toggleMusic()" class="fixed bottom-6 right-6 z-40 bg-sage-600 hover:bg-sage-700 text-white p-4 rounded-full shadow-lg transition-transform hover:scale-110 flex items-center justify-center w-12 h-12">
    <i id="musicIcon" class="fa-solid fa-music text-lg animate-spin" style="animation-duration: 4s;"></i>
  </button>

  <!-- COVER PEMBUKA OVERLAY -->
  <div id="welcomeCover" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-cream watercolor-overlay text-center p-6 transition-transform duration-1000">
    <div class="relative max-w-lg w-full p-8 rounded-3xl border border-sage-200/80 bg-white/70 backdrop-blur-md shadow-2xl">
      <div class="text-sage-600 text-4xl mb-4 animate-float">
        <i class="fa-solid fa-leaf"></i>
        <i class="fa-solid fa-seedling mx-2"></i>
        <i class="fa-solid fa-leaf transform -scale-x-100"></i>
      </div>
      
      <p class="uppercase tracking-[0.3em] text-xs font-semibold text-sage-600 mb-2">The Wedding Of</p>
      <h1 class="font-cursive text-5xl md:text-6xl text-sage-800 mb-4">Wang Li & Dinda</h1>
      <p class="font-serif italic text-gray-600 mb-6 text-lg">Minggu, 15 November 2026</p>
      
      <div class="border-t border-b border-sage-200 py-4 my-6">
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
        <p class="text-xl font-bold text-sage-800">Tamu Undangan</p>
      </div>

      <button onclick="openWedding()" class="bg-sage-600 hover:bg-sage-700 text-white font-medium px-8 py-3 rounded-full shadow-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center mx-auto space-x-2">
        <i class="fa-solid fa-envelope-open text-sm"></i>
        <span>Buka Undangan</span>
      </button>
    </div>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="max-w-4xl mx-auto px-4 py-8">

    <!-- HERO SECTION -->
    <section class="text-center py-16 px-4 relative">
      <div class="animate-float text-sage-600 text-3xl mb-2">
        <i class="fa-solid fa-spa"></i>
      </div>
      <p class="uppercase tracking-[0.4em] text-xs text-sage-600 font-semibold mb-3">Undangan Pernikahan Digital</p>
      <h1 class="font-cursive text-6xl md:text-7xl text-sage-800 mb-4">Wang Li & Dinda</h1>
      <p class="font-serif italic text-xl text-gray-600">"Dan di antara tanda-tanda kebesaran-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya."</p>
      
      <div class="mt-8 flex justify-center">
        <div class="w-16 h-0.5 bg-sage-600/40"></div>
      </div>
    </section>

    <!-- PROFIL MEMPELAI -->
    <section class="py-12">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-sage-800 font-bold mb-2">Pasangan Mempelai</h2>
        <p class="text-sm text-gray-500 italic">Dengan memohon rahmat dan ridho Tuhan, kami bermaksud menyelenggarakan pernikahan kami:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        
        <!-- Mempelai Pria -->
        <div class="bg-white/80 backdrop-blur-sm p-8 rounded-3xl border border-sage-100 shadow-xl text-center transition hover:shadow-2xl">
          <div class="w-40 h-40 mx-auto rounded-full overflow-hidden border-4 border-sage-200 p-1 mb-4">
            <!-- Foto Pengantin Pria Baru -->
            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=500" alt="Wang Li" class="w-full h-full object-cover rounded-full">
          </div>
          <h3 class="font-serif text-2xl font-bold text-sage-800">Wang Li</h3>
          <p class="text-xs text-sage-600 font-semibold uppercase tracking-wider my-1">Mempelai Pria</p>
          <p class="text-xs text-gray-500 mb-4">Putra Pertama dari Bapak Li Senior & Ibu Chen</p>
          <a href="https://instagram.com" target="_blank" class="inline-flex items-center space-x-2 text-xs bg-sage-50 text-sage-700 px-4 py-2 rounded-full border border-sage-200 hover:bg-sage-600 hover:text-white transition">
            <i class="fa-brands fa-instagram"></i>
            <span>@wangli.official</span>
          </a>
        </div>

        <!-- Mempelai Wanita -->
        <div class="bg-white/80 backdrop-blur-sm p-8 rounded-3xl border border-sage-100 shadow-xl text-center transition hover:shadow-2xl">
          <div class="w-40 h-40 mx-auto rounded-full overflow-hidden border-4 border-sage-200 p-1 mb-4">
            <!-- Foto Pengantin Wanita Baru (Dinda Cahaya Antika) -->
            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&q=80&w=500" alt="Dinda Cahaya Antika" class="w-full h-full object-cover rounded-full">
          </div>
          <h3 class="font-serif text-2xl font-bold text-sage-800">Dinda Cahaya Antika</h3>
          <p class="text-xs text-sage-600 font-semibold uppercase tracking-wider my-1">Mempelai Wanita</p>
          <p class="text-xs text-gray-500 mb-4">Putri Kedua dari Bapak Pratama & Ibu Wijaya</p>
          <a href="https://instagram.com" target="_blank" class="inline-flex items-center space-x-2 text-xs bg-sage-50 text-sage-700 px-4 py-2 rounded-full border border-sage-200 hover:bg-sage-600 hover:text-white transition">
            <i class="fa-brands fa-instagram"></i>
            <span>@dinda.official</span>
          </a>
        </div>

      </div>
    </section>

    <!-- COUNTDOWN TIMER -->
    <section class="py-12 my-8 bg-sage-600 text-white rounded-3xl shadow-2xl p-8 text-center relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 opacity-10 text-9xl">
        <i class="fa-solid fa-leaf"></i>
      </div>
      
      <h2 class="font-serif text-3xl font-bold mb-2">Menghitung Hari</h2>
      <p class="text-sage-100 text-xs uppercase tracking-widest mb-8">Menuju Hari Bahagia Kami</p>

      <div class="grid grid-cols-4 gap-4 max-w-lg mx-auto">
        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20">
          <span id="days" class="block font-serif text-3xl md:text-4xl font-bold">00</span>
          <span class="text-xs text-sage-100 uppercase">Hari</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20">
          <span id="hours" class="block font-serif text-3xl md:text-4xl font-bold">00</span>
          <span class="text-xs text-sage-100 uppercase">Jam</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20">
          <span id="minutes" class="block font-serif text-3xl md:text-4xl font-bold">00</span>
          <span class="text-xs text-sage-100 uppercase">Menit</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20">
          <span id="seconds" class="block font-serif text-3xl md:text-4xl font-bold">00</span>
          <span class="text-xs text-sage-100 uppercase">Detik</span>
        </div>
      </div>
    </section>

    <!-- ACARA & LOKASI -->
    <section class="py-12">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-sage-800 font-bold mb-2">Jadwal Acara</h2>
        <p class="text-sm text-gray-500 italic">Merupakan suatu kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- AKAD NIKAH -->
        <div class="bg-white/80 border border-sage-100 p-8 rounded-3xl shadow-lg text-center relative overflow-hidden">
          <div class="w-12 h-12 bg-sage-100 text-sage-700 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
            <i class="fa-solid fa-ring"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold text-sage-800 mb-2">Akad Nikah</h3>
          <p class="text-sage-600 font-medium text-sm mb-4">Minggu, 15 November 2026</p>
          <p class="text-gray-600 text-sm mb-6"><i class="fa-regular fa-clock text-sage-600 mr-2"></i>08.00 - 10.00 WIB</p>
          
          <div class="border-t border-sage-100 pt-4">
            <p class="font-bold text-gray-800 text-sm">Botanical Grand Ballroom</p>
            <p class="text-xs text-gray-500">Jl. Bunga Garden No. 88, Jakarta Selatan</p>
          </div>
        </div>

        <!-- RESEPSI -->
        <div class="bg-white/80 border border-sage-100 p-8 rounded-3xl shadow-lg text-center relative overflow-hidden">
          <div class="w-12 h-12 bg-sage-100 text-sage-700 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
            <i class="fa-solid fa-champagne-glasses"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold text-sage-800 mb-2">Resepsi</h3>
          <p class="text-sage-600 font-medium text-sm mb-4">Minggu, 15 November 2026</p>
          <p class="text-gray-600 text-sm mb-6"><i class="fa-regular fa-clock text-sage-600 mr-2"></i>11.00 - 14.00 WIB</p>
          
          <div class="border-t border-sage-100 pt-4">
            <p class="font-bold text-gray-800 text-sm">Botanical Grand Ballroom</p>
            <p class="text-xs text-gray-500">Jl. Bunga Garden No. 88, Jakarta Selatan</p>
          </div>
        </div>

      </div>

      <!-- GOOGLE MAPS BUTTON -->
      <div class="text-center mt-8">
        <a href="https://maps.google.com" target="_blank" class="inline-flex items-center space-x-2 bg-sage-700 hover:bg-sage-800 text-white px-6 py-3 rounded-full shadow-md transition transform hover:scale-105 text-sm font-medium">
          <i class="fa-solid fa-location-dot"></i>
          <span>Buka Google Maps</span>
        </a>
      </div>
    </section>

    <!-- GALERI PREWEDDING BARU -->
    <section class="py-12">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-sage-800 font-bold mb-2">Galeri Prewedding</h2>
        <p class="text-sm text-gray-500 italic">Momen kebahagiaan kami</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&q=80&w=600" alt="Gallery 1" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&q=80&w=600" alt="Gallery 2" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1469371670807-013ccf25f16a?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1469371670807-013ccf25f16a?auto=format&fit=crop&q=80&w=600" alt="Gallery 3" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&q=80&w=600" alt="Gallery 4" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?auto=format&fit=crop&q=80&w=600" alt="Gallery 5" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl shadow-md h-48 md:h-64 cursor-pointer" onclick="openLightbox('https://images.unsplash.com/photo-1525772764200-be829a350797?auto=format&fit=crop&q=80&w=800')">
          <img src="https://images.unsplash.com/photo-1525772764200-be829a350797?auto=format&fit=crop&q=80&w=600" alt="Gallery 6" class="w-full h-full object-cover hover:scale-110 transition duration-500">
        </div>
      </div>
    </section>

    <!-- AMPLOP DIGITAL / HADIAH -->
    <section class="py-12">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-sage-800 font-bold mb-2">Amplop Digital</h2>
        <p class="text-sm text-gray-500 italic">Doa restu Anda merupakan hadiah terindah bagi kami. Namun jika Anda ingin memberi hadiah, kami menyediakan Amplop Digital di bawah ini:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
        
        <!-- BCA -->
        <div class="bg-white p-6 rounded-3xl border border-sage-100 shadow-lg text-center">
          <div class="h-10 flex items-center justify-center mb-4 text-blue-800 font-bold text-xl tracking-wider">
            BCA
          </div>
          <p class="text-xs text-gray-500">No. Rekening</p>
          <p id="rekeningBCA" class="font-bold text-sage-800 text-lg mb-1">1234 5678 90</p>
          <p class="text-xs text-gray-600 mb-4">a.n. Wang Li</p>
          <button onclick="copyToClipboard('rekeningBCA', 'Nomor Rekening BCA')" class="w-full bg-sage-50 hover:bg-sage-100 text-sage-700 text-xs font-semibold py-2 px-4 rounded-xl border border-sage-200 transition">
            <i class="fa-regular fa-copy mr-1"></i> Salin Rekening
          </button>
        </div>

        <!-- Mandiri -->
        <div class="bg-white p-6 rounded-3xl border border-sage-100 shadow-lg text-center">
          <div class="h-10 flex items-center justify-center mb-4 text-blue-900 font-bold text-xl tracking-wider">
            MANDIRI
          </div>
          <p class="text-xs text-gray-500">No. Rekening</p>
          <p id="rekeningMandiri" class="font-bold text-sage-800 text-lg mb-1">9876 5432 10</p>
          <p class="text-xs text-gray-600 mb-4">a.n. Dinda</p>
          <button onclick="copyToClipboard('rekeningMandiri', 'Nomor Rekening Mandiri')" class="w-full bg-sage-50 hover:bg-sage-100 text-sage-700 text-xs font-semibold py-2 px-4 rounded-xl border border-sage-200 transition">
            <i class="fa-regular fa-copy mr-1"></i> Salin Rekening
          </button>
        </div>

        <!-- QRIS -->
        <div class="bg-white p-6 rounded-3xl border border-sage-100 shadow-lg text-center">
          <div class="h-10 flex items-center justify-center mb-2 text-gray-800 font-bold text-xl tracking-wider">
            QRIS
          </div>
          <div class="w-24 h-24 mx-auto bg-gray-100 p-2 rounded-xl mb-3 flex items-center justify-center border">
            <i class="fa-solid fa-qrcode text-5xl text-sage-700"></i>
          </div>
          <p class="text-xs text-gray-600 mb-3">Scan QRIS Angpao Digital</p>
          <button onclick="openLightbox('https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=Wedding-WangLi-Dinda')" class="w-full bg-sage-50 hover:bg-sage-100 text-sage-700 text-xs font-semibold py-2 px-4 rounded-xl border border-sage-200 transition">
            <i class="fa-solid fa-expand mr-1"></i> Perbesar QRIS
          </button>
        </div>

      </div>
    </section>

    <!-- UCAPAN & RSVP INTERAKTIF -->
    <section class="py-12">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-sage-800 font-bold mb-2">RSVP & Kartu Ucapan</h2>
        <p class="text-sm text-gray-500 italic">Berikan doa dan konfirmasi kehadiran Anda</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Form RSVP -->
        <div class="bg-white p-6 rounded-3xl border border-sage-100 shadow-lg">
          <form id="rsvpForm" onsubmit="handleFormSubmit(event)">
            <div class="mb-4">
              <label class="block text-xs font-semibold text-gray-600 uppercase mb-2">Nama Lengkap</label>
              <input type="text" id="guestName" required placeholder="Masukkan nama Anda" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-sage-600 text-sm">
            </div>

            <div class="mb-4">
              <label class="block text-xs font-semibold text-gray-600 uppercase mb-2">Konfirmasi Kehadiran</label>
              <select id="attendance" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-sage-600 text-sm bg-white">
                <option value="Hadir">Ya, Saya Akan Hadir</option>
                <option value="Tidak Hadir">Maaf, Saya Tidak Bisa Hadir</option>
              </select>
            </div>

            <div class="mb-4">
              <label class="block text-xs font-semibold text-gray-600 uppercase mb-2">Ucapan & Doa Restu</label>
              <textarea id="guestMessage" rows="4" required placeholder="Tuliskan ucapan dan doa terbaik Anda..." class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-sage-600 text-sm"></textarea>
            </div>

            <button type="submit" class="w-full bg-sage-600 hover:bg-sage-700 text-white font-medium py-3 rounded-xl shadow-md transition">
              Kirim Ucapan
            </button>
          </form>
        </div>

        <!-- Daftar Ucapan -->
        <div class="bg-white/80 p-6 rounded-3xl border border-sage-100 shadow-lg flex flex-col h-[380px]">
          <h3 class="font-serif text-xl font-bold text-sage-800 mb-4 border-b pb-2">
            Doa Restu (<span id="messageCount">2</span>)
          </h3>
          <div id="wishesList" class="overflow-y-auto space-y-4 pr-2 flex-grow">
            <!-- Sample wish 1 -->
            <div class="p-4 bg-sage-50 rounded-2xl border border-sage-100">
              <div class="flex justify-between items-center mb-1">
                <h4 class="font-bold text-sage-800 text-sm">Budi Santoso</h4>
                <span class="text-[10px] bg-sage-200 text-sage-800 px-2 py-0.5 rounded-full">Hadir</span>
              </div>
              <p class="text-xs text-gray-600 italic">"Selamat untuk Wang Li & Dinda! Semoga menjadi keluarga yang bahagia selamanya."</p>
            </div>

            <!-- Sample wish 2 -->
            <div class="p-4 bg-sage-50 rounded-2xl border border-sage-100">
              <div class="flex justify-between items-center mb-1">
                <h4 class="font-bold text-sage-800 text-sm">Siti Rahma</h4>
                <span class="text-[10px] bg-sage-200 text-sage-800 px-2 py-0.5 rounded-full">Hadir</span>
              </div>
              <p class="text-xs text-gray-600 italic">"Happy wedding! Lancar sampai hari H yaa."</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="text-center py-12 border-t border-sage-200/60 mt-12">
      <h3 class="font-cursive text-4xl text-sage-800 mb-2">Wang Li & Dinda</h3>
      <p class="text-xs text-gray-500 mb-4">Terima kasih atas doa & restu Bapak/Ibu/Saudara/i</p>
      <p class="text-[10px] text-sage-600 uppercase tracking-widest">Digital Wedding Invitation &copy; 2026</p>
    </footer>

  </main>

  <!-- LIGHTBOX IMAGE POPUP -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4" onclick="closeLightbox()">
    <div class="relative max-w-3xl w-full">
      <img id="lightboxImg" src="" alt="Enlarged gallery image" class="max-h-[85vh] mx-auto rounded-2xl shadow-2xl">
      <button onclick="closeLightbox()" class="absolute -top-10 right-0 text-white text-2xl hover:text-sage-200">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed top-6 right-6 z-50 bg-sage-800 text-white px-6 py-3 rounded-2xl shadow-2xl text-xs font-medium transform translate-y-[-100px] opacity-0 transition-all duration-300 flex items-center space-x-2">
    <i class="fa-solid fa-circle-check text-sage-400"></i>
    <span id="toastMessage">Pesan berhasil disalin!</span>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // 1. OPEN WEDDING & PLAY MUSIC
    let isPlaying = false;
    const music = document.getElementById('weddingMusic');
    const musicIcon = document.getElementById('musicIcon');

    function openWedding() {
      const cover = document.getElementById('welcomeCover');
      cover.style.transform = 'translateY(-100%)';
      playMusic();
    }

    function playMusic() {
      music.play().then(() => {
        isPlaying = true;
        musicIcon.classList.add('animate-spin');
      }).catch(err => {
        console.log("Audio autoplay prevented", err);
      });
    }

    function toggleMusic() {
      if (isPlaying) {
        music.pause();
        isPlaying = false;
        musicIcon.classList.remove('animate-spin');
      } else {
        music.play();
        isPlaying = true;
        musicIcon.classList.add('animate-spin');
      }
    }

    // 2. COUNTDOWN TIMER TARGET: 15 November 2026
    const targetDate = new Date('November 15, 2026 08:00:00').getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const difference = targetDate - now;

      if (difference > 0) {
        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((difference % (1000 * 60)) / 1000);

        document.getElementById('days').innerText = days < 10 ? '0' + days : days;
        document.getElementById('hours').innerText = hours < 10 ? '0' + hours : hours;
        document.getElementById('minutes').innerText = minutes < 10 ? '0' + minutes : minutes;
        document.getElementById('seconds').innerText = seconds < 10 ? '0' + seconds : seconds;
      } else {
        document.getElementById('days').innerText = '00';
        document.getElementById('hours').innerText = '00';
        document.getElementById('minutes').innerText = '00';
        document.getElementById('seconds').innerText = '00';
      }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // 3. COPY TO CLIPBOARD & TOAST
    function copyToClipboard(elementId, label) {
      const textToCopy = document.getElementById(elementId).innerText;
      navigator.clipboard.writeText(textToCopy).then(() => {
        showToast(`${label} berhasil disalin!`);
      });
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toastMessage');
      toastMessage.innerText = message;

      toast.classList.remove('translate-y-[-100px]', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-[-100px]', 'opacity-0');
      }, 3000);
    }

    // 4. RSVP & WISHES FORM INTERACTION
    let wishCount = 2;
    function handleFormSubmit(event) {
      event.preventDefault();

      const name = document.getElementById('guestName').value;
      const status = document.getElementById('attendance').value;
      const message = document.getElementById('guestMessage').value;

      const wishesList = document.getElementById('wishesList');

      const wishCard = document.createElement('div');
      wishCard.className = 'p-4 bg-sage-50 rounded-2xl border border-sage-100';
      wishCard.innerHTML = `
        <div class="flex justify-between items-center mb-1">
          <h4 class="font-bold text-sage-800 text-sm">${name}</h4>
          <span class="text-[10px] ${status === 'Hadir' ? 'bg-sage-200 text-sage-800' : 'bg-gray-200 text-gray-700'} px-2 py-0.5 rounded-full">${status}</span>
        </div>
        <p class="text-xs text-gray-600 italic">"${message}"</p>
      `;

      wishesList.prepend(wishCard);
      wishCount++;
      document.getElementById('messageCount').innerText = wishCount;

      document.getElementById('rsvpForm').reset();
      showToast('Ucapan Anda berhasil dikirim!');
    }

    // 5. LIGHTBOX FUNCTIONALITY
    function openLightbox(imgUrl) {
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      lightboxImg.src = imgUrl;
      lightbox.classList.remove('hidden');
    }

    function closeLightbox() {
      const lightbox = document.getElementById('lightbox');
      lightbox.classList.add('hidden');
    }
  </script>
</body>
</html>
              
  
      
      
        

            
              
